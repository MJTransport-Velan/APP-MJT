NODE_ENV=development
PORT=5000

DATABASE_URL="postgresql://postgres:admin@localhost:5432/mj_transport_erp?schema=public"

JWT_ACCESS_SECRET=change_this_access_secret_key
JWT_REFRESH_SECRET=change_this_refresh_secret_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated allowlist. The ERP frontend (5173) and the public MJ Express
# website (5174), which calls this API directly for bookings and tracking.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Ceilings for the unauthenticated /api/public/* routes, tighter than the global
# limiter below because they write rows and consume document numbers.
PUBLIC_WRITE_MAX=10
PUBLIC_WRITE_WINDOW_MS=900000
PUBLIC_LOOKUP_MAX=30
PUBLIC_LOOKUP_WINDOW_MS=60000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5000

# Sign-in attempts per IP per window. Successful logins are not counted.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
