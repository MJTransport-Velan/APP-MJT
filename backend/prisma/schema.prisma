enum ExceptionErrorType {
  DUPLICATE
  NEGATIVE_BALANCE
  MISSING_APPROVAL
  VOUCHER_FAILURE
  POSTING_FAILURE
  VALIDATION_FAILURE
  UNEXPECTED
