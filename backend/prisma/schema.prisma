enum ApprovalMode {
  SEQUENTIAL
  PARALLEL
}

model ApprovalDelegation {
  id             String   @id @default(uuid())
  organizationId String
  fromUserId     String
  toUserId       String
  fromDate       DateTime
  toDate         DateTime
  reason         String?
  isActive       Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now())

  @@index([organizationId, fromUserId, isActive])
  @@map("approval_delegations")
}

// ApprovalEscalationLog removed in the Phase 14 architecture optimization
// pass — it was a structural duplicate of an AuditLog row (entityType,
