  code         String              @unique
  channel      NotificationChannel
  subject      String?
  bodyTemplate String
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@map("notification_templates")
}

// -----------------------------------------------------------
// Approval Engine extensions — temporary substitution and the
// escalation trail. The core level/role/amount engine from Phase 7
// (docs) ApprovalRule/VoucherApproval is untouched; escalation
