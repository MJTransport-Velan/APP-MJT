  updatedAt      DateTime          @updatedAt

  driver     Driver            @relation(fields: [driverId], references: [id])
  trip       Trip?             @relation(fields: [tripId], references: [id])
  settlement DriverSettlement? @relation("DriverSettlementPenalties", fields: [settlementId], references: [id])

  @@index([driverId])
  @@index([tripId])
  @@index([settlementId])
