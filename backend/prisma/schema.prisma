// -----------------------------------------------------------
// Business Rule Engine — a configuration registry + evaluator
// (backend/src/utils/businessRuleEngine.util.ts). Existing inline
// validations in prior-phase services (credit limit checks, GST
// slab checks, etc.) are left exactly as they are; this registry is
// additive and is wired into the new Duplicate Voucher Detection
// scan (DUPLICATE_DETECTION) and is available for future rule types
// without another migration, since conditionJson/actionJson are
// schemaless by design.
// -----------------------------------------------------------
enum BusinessRuleType {
  CREDIT_LIMIT
  PAYMENT
  LOAN
  PAYROLL
  EXPENSE
  GST
  APPROVAL
  DUPLICATE_DETECTION
}

model BusinessRule {
  id             String           @id @default(uuid())
  organizationId String
  ruleType       BusinessRuleType
  name           String
  description    String?
  conditionJson  String
  actionJson     String?
  priority       Int              @default(1)
  isActive       Boolean          @default(true)
  createdById    String?
  updatedById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  @@index([organizationId, ruleType, isActive])
  @@map("business_rules")
}

// -----------------------------------------------------------
// Import Framework — reuses each target entity's own existing
// create() service method per row (Ledger/Supplier/Employee/Driver/
// OpeningBalanceEntry), so bulk-imported rows go through the exact
// same validation every manually-created row does. This model is
// only the batch's own tracking/audit record.
// -----------------------------------------------------------
enum ImportEntityType {
  SUPPLIER
  EMPLOYEE
  DRIVER
  FUEL_ENTRY
  FASTTAG_TRANSACTION
}

enum ImportBatchStatus {
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

model ImportBatch {
  id              String            @id @default(uuid())
  organizationId  String
  entityType      ImportEntityType
  fileName        String
  status          ImportBatchStatus @default(PROCESSING)
  totalRows       Int               @default(0)
  successRows     Int               @default(0)
  failedRows      Int               @default(0)
  errorReportJson String?
  importedById    String?
  startedAt       DateTime          @default(now())
  completedAt     DateTime?

  @@index([organizationId, entityType])
  @@map("import_batches")
}

// -----------------------------------------------------------
// Backup & Recovery — "Restore Validation" only (design brief item),
// deliberately not "Restore Execution": actually overwriting a live
// production database is a destructive action this ERP's automation
// must never perform unattended.
// -----------------------------------------------------------
enum BackupType {
  FULL
  INCREMENTAL
}

enum BackupStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum BackupTrigger {
  MANUAL
  SCHEDULED
}

model BackupRecord {
  id            String        @id @default(uuid())
  type          BackupType    @default(FULL)
  status        BackupStatus  @default(RUNNING)
  triggeredBy   BackupTrigger @default(MANUAL)
  fileName      String?
  filePath      String?
  sizeBytes     BigInt?
  startedAt     DateTime      @default(now())
  completedAt   DateTime?
  verifiedAt    DateTime?
  errorMessage  String?
  triggeredById String?

  @@index([status, startedAt])
  @@map("backup_records")
}

// -----------------------------------------------------------
// Data Archiving — scoped to log/trail data only (Audit/Activity/
// VoucherAuditEntry/ApiRequestLog/WebhookDelivery are safe to prune);
// Voucher archiving reuses the VoucherStatus.ARCHIVED value Phase 2
// already defined — this scans and transitions old CANCELLED/POSTED
// Vouchers past retention to that existing status, never altering
// financial figures.
// -----------------------------------------------------------
enum ArchiveScope {
  AUDIT_LOG
  API_REQUEST_LOG
  WEBHOOK_DELIVERY
}

enum ArchiveRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

model ArchiveRun {
  id              String           @id @default(uuid())
  scope           ArchiveScope
  cutoffDate      DateTime
  recordsArchived Int              @default(0)
  status          ArchiveRunStatus @default(RUNNING)
  errorMessage    String?
  triggeredById   String?
  startedAt       DateTime         @default(now())
  completedAt     DateTime?

  @@index([scope, startedAt])
  @@map("archive_runs")
}

// -----------------------------------------------------------
// System Configuration — the generic key/value settings store no
// prior phase had (AccountingPreference from Phase 7 (docs Phase 1)
// stays exactly as-is for accounting-specific behavior; this is for
// everything Phase 8 itself introduces: security, notification,
// workflow, backup and API settings).
// -----------------------------------------------------------
enum SystemSettingCategory {
  GENERAL
  ACCOUNTING
  NOTIFICATION
  WORKFLOW
  BACKUP
  SECURITY
  API
  // Phase 14 optimization pass — IntegrationConnector's 11 connector
  // types were a full model+service+UI tab for something that only ever
  // stored a JSON config blob + an optional reachability check. Folded
  // here as a settings category instead (key = connector type/name,
  // value = JSON config) — same information, one fewer module.
  INTEGRATION
}

model SystemSetting {
  id             String                @id @default(uuid())
  organizationId String
  category       SystemSettingCategory
  key            String
  value          String
  description    String?
  updatedById    String?
  updatedAt      DateTime              @updatedAt
  createdAt      DateTime              @default(now())

  @@unique([organizationId, category, key])
  @@map("system_settings")
}

// -----------------------------------------------------------
// Integration Gateway — folded into SystemSetting (category
// INTEGRATION) during the Phase 14 optimization pass. A dedicated
// model + service + UI tab was overkill for rows that only ever store
// a JSON config blob; SystemSetting's existing key/value shape covers
// it (key = connector type/name, value = JSON config).
// -----------------------------------------------------------
// REST API Governance
// -----------------------------------------------------------
model ApiKey {
  id                 String    @id @default(uuid())
  organizationId     String
  name               String
  keyPrefix          String
  keyHash            String
  scopes             String // comma-separated permission-like scopes
  rateLimitPerMinute Int       @default(60)
  isActive           Boolean   @default(true)
  expiresAt          DateTime?
  lastUsedAt         DateTime?
  createdById        String?
  createdAt          DateTime  @default(now())
  revokedAt          DateTime?

  @@index([organizationId, isActive])
  @@map("api_keys")
}

// -----------------------------------------------------------
// Webhook Foundation — outgoing events only (design brief lists
// Incoming Events too, but nothing in this ERP yet needs to receive
// a webhook; the inbound side is a receiver endpoint with no
// subscriber, so it's left for the integration that first needs it).
// -----------------------------------------------------------
enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

model WebhookSubscription {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  url            String
  secret         String
  eventTypes     String // comma-separated event codes
  isActive       Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([organizationId, isActive])
  @@map("webhook_subscriptions")
}

model WebhookDelivery {
  id             String                @id @default(uuid())
  subscriptionId String
  eventType      String
  payloadJson    String
  signature      String
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  lastAttemptAt  DateTime?
  responseStatus Int?
  responseBody   String?
  createdAt      DateTime              @default(now())

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, status])
  @@map("webhook_deliveries")
}

// -----------------------------------------------------------
// AI Foundation — "No AI implementation required" per the design
// brief; method STATISTICAL is a real, deterministic computation
// (moving-average / linear-regression over existing Ledger movement,
// the same primitives Phase 13's MIS Dashboard uses) so the feature
// genuinely works today, with ML/LLM left as swap-in future methods
// against the same result shape.
// -----------------------------------------------------------
enum AiInsightType {
  CASH_FLOW_PREDICTION
  EXPENSE_FORECAST
  OUTSTANDING_PREDICTION
  DUPLICATE_VOUCHER_FLAG
}

enum AiInsightMethod {
  STATISTICAL
  ML
  LLM
}

model AiInsight {
  id             String          @id @default(uuid())
  organizationId String
  type           AiInsightType
  method         AiInsightMethod @default(STATISTICAL)
  periodLabel    String?
  resultJson     String
  confidence     Float?
  generatedAt    DateTime        @default(now())

  @@index([organizationId, type, generatedAt])
  @@map("ai_insights")
}

// -----------------------------------------------------------
// Business Intelligence Foundation — KPI Engine. KpiDefinition is
// seeded reference metadata; KpiSnapshot is populated by the
// COMPUTE_KPI_SNAPSHOTS automation action, reading the same
// Phase 13 (docs Phase 7) report primitives read-only.
// -----------------------------------------------------------
model KpiDefinition {
  id                 String   @id @default(uuid())
  code               String   @unique
  name               String
  category           String
  formulaDescription String
  unit               String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  snapshots KpiSnapshot[]

  @@map("kpi_definitions")
}

model KpiSnapshot {
  id              String   @id @default(uuid())
  kpiDefinitionId String
  organizationId  String
  periodDate      DateTime
  value           Decimal  @db.Decimal(18, 2)
  dimensionJson   String?
  createdAt       DateTime @default(now())

  kpiDefinition KpiDefinition @relation(fields: [kpiDefinitionId], references: [id], onDelete: Cascade)

  @@index([organizationId, kpiDefinitionId, periodDate])
  @@map("kpi_snapshots")
}

// -----------------------------------------------------------
// Phase 15 — Business Financial Entry (Simplified Accounting UX).
//
// Every prior phase built a real double-entry engine (AccountGroup/
// Ledger/VoucherType/Voucher/VoucherLine) and a set of specialized
// business flows on top of it (Receipt, SupplierPayment, DriverAdvance,
// EmployeeAdvance, BankTransfer, VehicleExpense...). None of that is
// replaced here. FinancialEntry is a single new business-facing front
// door — "where did money come from / where is it now / what for /
// how much is allocated" — that either delegates to one of those
// existing flows (when the source/destination combination matches one
// exactly, so the specialized receivable/payable/advance bookkeeping
// those flows already maintain keeps working unmodified) or, when none
// applies, posts a plain Voucher itself through the same voucherService
// every other module uses (see financial-entry.service.ts). Either way
// this table is the one list a non-accountant reads; Voucher/Ledger
// stay real underneath but are never surfaced through this API.
// -----------------------------------------------------------

enum FinancialEntryType {
  MONEY_RECEIVED
  MONEY_PAID
  MONEY_TRANSFER
  EXPENSE
  ADVANCE_RECEIVED
  ADVANCE_GIVEN
  REFUND_RECEIVED
  REFUND_PAID
  LOAN_RECEIVED
  LOAN_REPAYMENT
  SALARY_SETTLEMENT
  ADJUSTMENT
}

// Shared by FinancialEntry.sourceType/destinationType — one enum for
// "which real-world master this money touches," the same reasoning
// LedgerPartyType already uses for both sides of a VoucherLine.
// VEHICLE/TRIP/EXPENSE carry no ledger of their own — they resolve to a
// purpose-based expense ledger plus (best-effort) cost-center
// attribution, never a party ledger — see resolveFinancialLedger() in
// financialLedger.util.ts.
enum FinancialPartyType {
  CUSTOMER
  SUPPLIER
  DRIVER
  EMPLOYEE
  BANK
  CASH
  LOAN_PROVIDER
  VEHICLE
  TRIP
  EXPENSE
  OTHER
}

enum FinancialEntryStatus {
  DRAFT
  COMPLETED
  // PARTIALLY_ALLOCATED/FULLY_ALLOCATED are no longer written by the
  // application (the manual allocation feature was removed) — left in the
  // enum rather than dropped, since Postgres has no simple "drop enum
  // value" and no row ever used them outside of that removed feature.
  PARTIALLY_ALLOCATED
  FULLY_ALLOCATED
  CANCELLED
  REVERSED
}

enum FinancialEntryPurpose {
  TRIP_ADVANCE
  TRIP_PAYMENT
  SUPPLIER_PAYMENT
  CLIENT_PAYMENT
  DRIVER_ADVANCE
  SALARY
  FUEL
  REPAIR
  INSURANCE
  LOAN_EMI
  CUSTOMER_REFUND
  SUPPLIER_REFUND
  OFFICE_EXPENSE
  // Additive — lets an EXPENSE entry against a Vehicle also log a real
  // FastTagTransaction (fastTagLink below), the same way FUEL logs a
  // FuelEntry, instead of falling back to the pooled misc-expense ledger.
  TOLL
  OTHER
}

model FinancialEntry {
  id                   String                @id @default(uuid())
  organizationId       String
  entryNumber          String
  entryType            FinancialEntryType
  entryDate            DateTime              @db.Date
  sourceType           FinancialPartyType
  sourceId             String?
  sourceLabel          String
  destinationType      FinancialPartyType
  destinationId        String?
  destinationLabel     String
  amount               Decimal               @db.Decimal(18, 2)
  paymentModeId        String?
  referenceNumber      String?
  remarks              String?
  purpose              FinancialEntryPurpose @default(OTHER)
  purposeNotes         String?
  status               FinancialEntryStatus  @default(DRAFT)
  // Set only when create() delegated to an existing specialized flow —
  // e.g. sourceDocumentType: "Receipt", sourceDocumentId: <receipt.id> —
  // so the entry can still be traced back to the record actually holding
  // the specialized state (isAdvance, invoice link, settlement link...).
  // Null when the generic direct-voucher posting path was used instead.
  sourceDocumentType   String?
  sourceDocumentId     String?
  // FIFO settlement breakdown for Customer/Supplier entries that get
  // auto-split across multiple Invoices/SupplierBills/Trips instead of
  // one lump Receipt/SupplierPayment — see fifoSettlement.util.ts. Each
  // element is { targetType, targetId, targetLabel, amount,
  // sourceDocumentType, sourceDocumentId, voucherId }. Deliberately a
  // JSON array here rather than a new table — this is a read-only replay
  // of what create()/cancel()/reverse() already did against real rows
  // (Receipt/SupplierPayment/Voucher), not a second source of truth for
  // any balance (design constraint: no duplicate allocation engines).
  settlementPlan       Json?
  // Optional Fleet-module linkage — set when this entry's Purpose is
  // FUEL/TOLL and the extra fields needed to log a real FuelEntry /
  // FastTagTransaction were supplied, so Fleet's own screens stay in
  // sync instead of only a ledger posting existing (design intent: see
  // "diesel and fast[tag]" follow-up request).
  vehicleId            String?
  tripId               String?
  quantityLiters       Decimal?              @db.Decimal(10, 2)
  ratePerLiter         Decimal?              @db.Decimal(10, 2)
  odometerReading      Int?
  fuelEntryId          String?
  fastTagTransactionId String?
  correctionOfId       String?               @unique
  reversalOfId         String?               @unique
  cancelledById        String?
  cancelledAt          DateTime?
  cancellationReason   String?
  createdById          String?
  updatedById          String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  paymentMode        PaymentMode?        @relation(fields: [paymentModeId], references: [id])
  correctionOf       FinancialEntry?     @relation("FinancialEntryCorrection", fields: [correctionOfId], references: [id])
  correctedBy        FinancialEntry?     @relation("FinancialEntryCorrection")
  reversalOf         FinancialEntry?     @relation("FinancialEntryReversal", fields: [reversalOfId], references: [id])
  reversedBy         FinancialEntry?     @relation("FinancialEntryReversal")
  vehicle            Vehicle?            @relation(fields: [vehicleId], references: [id])
  trip               Trip?               @relation(fields: [tripId], references: [id])
  fuelEntry          FuelEntry?          @relation(fields: [fuelEntryId], references: [id])
  fastTagTransaction FastTagTransaction? @relation(fields: [fastTagTransactionId], references: [id])

  @@unique([organizationId, entryNumber])
  @@index([organizationId, entryType])
  @@index([sourceType, sourceId])
  @@index([destinationType, destinationId])
  @@index([status])
  @@map("financial_entries")
}

// ---------------------------------------------------------------------------
// Phase 16 — Booking & LR (Lorry Receipt)
//
// Parcel bookings submitted by the public MJ Express website, which has no
// backend or database of its own and posts straight to this API. MJSoftware
// is the sole owner of booking data: it mints the Booking/LR/Tracking numbers,
// drives the workflow, and renders the LR document.
// ---------------------------------------------------------------------------

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  VEHICLE_ASSIGNED
  LR_GENERATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
}

// Which channel a booking arrived through. WEBSITE bookings are typed by the
// customer and need their route mapped at confirmation; COUNTER bookings are
// keyed in by staff, who pick the route and agree a price up front.
enum BookingSource {
  WEBSITE
  COUNTER
}

model Booking {
  id        String @id @default(uuid())
  bookingNo String @unique

  // Consignor/consignee identity is plain text, not a Company FK: bookings
  // arrive from walk-in customers on the public site who are not onboarded
  // as Companies. Same reasoning as Trip's market-truck fields.
  customerName    String
  mobile          String
  email           String?
  pickupAddress   String
  deliveryAddress String

  fromPlace            String
  toPlace              String
  parcelType           String
  packages             Int
  weight               Decimal   @db.Decimal(10, 2)
  // What the customer asked for on the website, free text from a fixed
  // picklist — distinct from vehicleTypeName below, which is what was
  // actually allocated.
  vehicleTypeRequested String
  pickupDate           DateTime
  expectedDeliveryDate DateTime?
  instructions         String?

  status BookingStatus @default(PENDING)
  source BookingSource @default(WEBSITE)

  // Agreed price, captured only for counter bookings — the public site does
  // not quote. Copied onto the Intent and Trip so these jobs carry a value in
  // Operations and reach Trip Financials like any other.
  freightAmount Decimal? @db.Decimal(12, 2)

  // Minted server-side when the booking is confirmed. Format is
  // PREFIX + YYYYMMDD + 4-digit daily sequence (BK202608200001), issued
  // atomically via DocumentCounter.
  lrNumber       String? @unique
  trackingNumber String? @unique

  // Vehicle allocation. fleetType is the Own/Market toggle: OWN resolves
  // vehicleId/driverId against the fleet masters; MARKET leaves both null and
  // captures the ad-hoc truck as free text. Mirrors Trip's allocation shape.
  fleetType VehicleOwnership?
  vehicleId String?
  driverId  String?

  // Snapshot of whichever source was used, frozen at allocation time so that
  // later edits to a Vehicle/Driver master can never rewrite an issued LR.
  vehicleNumber   String?
  vehicleTypeName String?
  driverName      String?
  driverMobile    String?

  // The public site captures fromPlace/toPlace as free text typed by the
  // customer. An admin maps them to the master at confirmation time, so
  // customer typos never create Location rows on their own.
  fromLocationId String?
  toLocationId   String?

  rejectionReason String?
  lrGeneratedAt   DateTime?
  deliveredAt     DateTime?

  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  vehicle      Vehicle?  @relation(fields: [vehicleId], references: [id])
  driver       Driver?   @relation(fields: [driverId], references: [id])
  fromLocation Location? @relation("BookingFromLocation", fields: [fromLocationId], references: [id])
  toLocation   Location? @relation("BookingToLocation", fields: [toLocationId], references: [id])

  statusHistory BookingStatusHistory[]

  @@index([status])
  @@index([mobile])
  @@index([createdAt])
  @@index([vehicleId])
  @@index([driverId])
  @@map("bookings")
}

// Append-only trail of workflow transitions. Backs the dated timeline on the
// public tracking page, so tracking reports when each stage actually happened
// rather than only the current status.
model BookingStatusHistory {
  id          String        @id @default(uuid())
  bookingId   String
  status      BookingStatus
  note        String?
  createdById String?
  createdAt   DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_status_history")
}

// Enquiries submitted through the contact form on the public MJ Express
// website. Kept alongside Booking because it arrives through the same public
// intake surface and for the same reason — the website has no database of its
// own. Write-only today, exactly as it was before the migration.
model ContactEnquiry {
  id        String   @id @default(uuid())
  name      String
  phone     String
  email     String?
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("contact_enquiries")
}

// Atomic per-day document sequence. The public booking endpoint is
// internet-facing and can take concurrent submissions, where the count()+1
// idiom used by the internal modules would race two callers to the same
// number and fail one of them on the unique constraint. A single upsert with
// an atomic increment (INSERT ... ON CONFLICT DO UPDATE seq = seq + 1) hands
// out each number exactly once without a transaction or retry loop.
model DocumentCounter {
  id        String   @id @default(uuid())
  key       String   @unique
  seq       Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("document_counters")
}

// ===========================================================
// PHASE 18 - OPENING BALANCE & MIGRATION
// ===========================================================
// Brings the financial position across from the old Tally books without
// recreating a single historical transaction: Tally's CLOSING position
// becomes this system's OPENING position, and live transactions start from
// the migration date.
//
// An opening balance is NOT income, expense, receipt or payment - nothing
// here writes a FinancialEntry, so opening amounts can never distort
// current-period Profit & Loss.
//
// Where an opening amount belongs to a register that already exists, it is
// stored THERE rather than duplicated here:
//   - opening assets -> FixedAsset.assetOrigin = OPENING
//   - opening loans  -> Loan.origin = OPENING
// The rows below cover what has no register of its own: bank/cash balances,
// customer/supplier outstandings, owner funds and free-form adjustments.

enum MigrationStatus {
  DRAFT
  FINALIZED
}

enum AssetOrigin {
  OPENING
  NEW_PURCHASE
}

enum LoanOrigin {
  OPENING
  NEW
}

/// Per-row audit trail for the migration: how sure the user is about a
/// figure typed in from the old system.
enum MigrationRecordStatus {
  CONFIRMED
  NEEDS_REVIEW
  UNVERIFIED
  RECLASSIFIED
}

enum OpeningBalanceCategory {
  BANK
  CASH
  RECEIVABLE
  PAYABLE
  OWNER_FUNDS
  OTHER_ASSET
  OTHER_LIABILITY
  OTHER_EQUITY
}

/// Money an owner handed the business before the migration is not
/// necessarily capital - part of it is often a debt the business owes back.
/// Until the user says which, it stays UNCLASSIFIED and is reported as an
/// unreconciled opening amount rather than silently boosting equity.
enum OpeningFundClassification {
  CAPITAL
  OWNER_LOAN
  OTHER_LIABILITY
  UNCLASSIFIED
}

model FinancialMigration {
  id                  String          @id @default(uuid())
  migrationDate       DateTime        @db.Date
  previousSystem      String          @default("Tally")
  previousClosingDate DateTime?       @db.Date
  notes               String?
  status              MigrationStatus @default(DRAFT)
  finalizedAt         DateTime?
  finalizedById       String?
  organizationId      String?
  isActive            Boolean         @default(true)
  deletedAt           DateTime?
  createdById         String?
  updatedById         String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  openingBalances OpeningBalance[]

  @@map("financial_migrations")
}

model OpeningBalance {
  id          String                 @id @default(uuid())
  migrationId String
  category    OpeningBalanceCategory
  amount      Decimal                @db.Decimal(18, 2)

  // Exactly one of these is set, decided by `category`; validated in the
  // service layer the same way every other polymorphic link in this app is.
  bankAccountId    String?
  cashAccountId    String?
  companyId        String?
  supplierId       String?
  capitalPartnerId String?
  /// Name of a free-form OTHER_ASSET / OTHER_LIABILITY / OTHER_EQUITY row.
  label            String?

  classification  OpeningFundClassification?
  status          MigrationRecordStatus      @default(UNVERIFIED)
  source          String                     @default("Tally Migration")
  referenceNumber String?
  /// The old invoice/bill date where known - used for receivable/payable aging.
  referenceDate   DateTime?
  remarks         String?

  /// What has already been pushed into BankAccount/CashAccount.currentBalance,
  /// so an edited opening balance moves the account by the DIFFERENCE instead
  /// of adding the whole amount a second time.
  appliedAmount Decimal @default(0) @db.Decimal(18, 2)

  organizationId String?
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdById    String?
  updatedById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  migration      FinancialMigration @relation(fields: [migrationId], references: [id], onDelete: Cascade)
  bankAccount    BankAccount?       @relation(fields: [bankAccountId], references: [id])
  cashAccount    CashAccount?       @relation(fields: [cashAccountId], references: [id])
  company        Company?           @relation(fields: [companyId], references: [id])
  supplier       Supplier?          @relation(fields: [supplierId], references: [id])
  capitalPartner CapitalPartner?    @relation(fields: [capitalPartnerId], references: [id])

  @@index([migrationId])
  @@index([category])
  @@index([companyId])
  @@index([supplierId])
  @@map("opening_balances")
}
