enum DriverSettlementType {
  PARTIAL
  FINAL
  EXIT
  YEAR_END
}

enum DriverSettlementStatus {
  DRAFT
  CALCULATED
  APPROVED
  PAID
}

enum SettlementLineSourceType {
  ADVANCE
  ALLOWANCE
  INCENTIVE
  PENALTY
  SALARY
}

enum LineDirection {
  DEBIT
  CREDIT
}

enum DriverSalaryType {
  FIXED
  PERCENT_OF_FREIGHT
}

// A driver's base pay, distinct from the ad-hoc DriverEarning entries
// (bata/incentives) — feeds the SALARY line in DriverSettlement.computeDraft().
// Versioned like SalaryStructure: creating a new one deactivates the prior
// rather than overwriting it, but (unlike SalaryStructure) settlement
// calculation always reads whichever one is currently isActive, not a
// point-in-time lookup — same simplification the Employee track already uses.
model DriverSalaryStructure {
  id            String           @id @default(uuid())
  driverId      String
  salaryType    DriverSalaryType
  fixedAmount   Decimal?         @db.Decimal(12, 2)
  percentValue  Decimal?         @db.Decimal(5, 2)
  effectiveFrom DateTime
  isActive      Boolean          @default(true)
  deletedAt     DateTime?
  createdById   String?
  updatedById   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  driver Driver @relation(fields: [driverId], references: [id])

  @@index([driverId])
  @@map("driver_salary_structures")
}

// Driver equivalent of EmployeeSalaryPayment — same "one row per driver per
// month" paid-flag, written by financial-entry.service.ts's
// delegateToDriverSalaryPayment. Deliberately independent of
// DriverEarning/DriverSettlement (the trip-based bata/incentive/penalty
// system) — this is only for a driver on a fixed/simple Driver Salary
// Structure being paid a flat monthly amount.
model DriverSalaryPayment {
  id          String   @id @default(uuid())
  driverId    String
  year        Int
  month       Int
  amount      Decimal  @db.Decimal(12, 2)
  paidDate    DateTime @db.Date
  createdById String?
  createdAt   DateTime @default(now())

  driver Driver @relation(fields: [driverId], references: [id])

  @@unique([driverId, year, month])
  @@index([driverId])
  @@map("driver_salary_payments")
}

// A period (or explicit trip-batch) sweep, not an allocation against a
// single bill — there's no discrete "driver bill," only a continuous
// stream of ledger-affecting documents (design doc §12).
model DriverSettlement {
  id               String                 @id @default(uuid())
  settlementNumber String                 @unique
  driverId         String
  settlementType   DriverSettlementType   @default(PARTIAL)
  periodStart      DateTime
  periodEnd        DateTime
  status           DriverSettlementStatus @default(DRAFT)
  grossEarnings    Decimal                @default(0) @db.Decimal(12, 2)
  totalDeductions  Decimal                @default(0) @db.Decimal(12, 2)
  netPayable       Decimal                @default(0) @db.Decimal(12, 2)
  approvedById     String?
  organizationId   String?
  isActive         Boolean                @default(true)
  deletedAt        DateTime?
  createdById      String?
  updatedById      String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  driver    Driver                 @relation(fields: [driverId], references: [id])
  lines     DriverSettlementLine[]
  advances  DriverAdvance[]        @relation("DriverSettlementAdvances")
  earnings  DriverEarning[]        @relation("DriverSettlementEarnings")
  penalties DriverPenalty[]        @relation("DriverSettlementPenalties")

  @@index([driverId])
  @@map("driver_settlements")
}

// A polymorphic breakdown line — full traceability, and this same line
// set rendered chronologically is the Driver Statement (design doc §12,
// §19). sourceId is a plain uuid (not a physical FK), the same app-level
// polymorphic-reference pattern as VoucherLine.partyId/CostCenter.refId.
model DriverSettlementLine {
  id           String                   @id @default(uuid())
  settlementId String
  sourceType   SettlementLineSourceType
  sourceId     String?
  description  String
  amount       Decimal                  @db.Decimal(12, 2)
  direction    LineDirection
  createdAt    DateTime                 @default(now())

  settlement DriverSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([settlementId])
  @@map("driver_settlement_lines")
}

enum SalaryComponentType {
  BASIC
  HRA
  DA
  SPECIAL_ALLOWANCE
  TRAVEL_ALLOWANCE
  MEDICAL_ALLOWANCE
  PF
  ESI
  PROFESSIONAL_TAX
  TDS
  OTHER_DEDUCTION
  BONUS
  ARREARS
  LEAVE_DEDUCTION
  ATTENDANCE_DEDUCTION
  OVERTIME
  RECOVERY
  MANUAL_ADJUSTMENT
  CUSTOM
}

enum SalaryCalculationType {
  FIXED_AMOUNT
  PERCENT_OF_BASIC
  PERCENT_OF_GROSS
}

// Versioned (effectiveFrom/To) — a raise never overwrites history. Exactly
// one active structure per employee at a time (design doc §8).
model SalaryStructure {
  id            String    @id @default(uuid())
  employeeId    String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  createdById   String?
  updatedById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employee   Employee                   @relation(fields: [employeeId], references: [id])
  components SalaryStructureComponent[]

  @@index([employeeId])
  @@map("salary_structures")
}

model SalaryStructureComponent {
  id                String                @id @default(uuid())
  salaryStructureId String
  componentType     SalaryComponentType
  name              String?
  calculationType   SalaryCalculationType @default(FIXED_AMOUNT)
  value             Decimal               @db.Decimal(12, 2)
  isEarning         Boolean
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)

  @@index([salaryStructureId])
  @@map("salary_structure_components")
}

// Replaces the old multi-step PayrollRun engine for regular employees — a
// Financial Entry with purpose=SALARY against this employee marks their
// current calendar month paid directly (financial-entry.service.ts
// delegateToEmployeeSalaryPayment). One row per employee per month; the
// unique constraint is what blocks a duplicate payment for the same month.
model EmployeeSalaryPayment {
  id          String   @id @default(uuid())
  employeeId  String
  year        Int
  month       Int
  amount      Decimal  @db.Decimal(12, 2)
  paidDate    DateTime @db.Date
  createdById String?
  createdAt   DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, year, month])
  @@index([employeeId])
  @@map("employee_salary_payments")
}

enum EmployeeAdvanceType {
  SALARY_ADVANCE
  EMERGENCY_ADVANCE
  MEDICAL_ADVANCE
  ADVANCE_AGAINST_SALARY
  OTHER
}

model EmployeeAdvance {
  id              String              @id @default(uuid())
  advanceNumber   String              @unique
  employeeId      String
  advanceType     EmployeeAdvanceType
  purpose         String?
  amount          Decimal             @db.Decimal(12, 2)
  requestedById   String?
  approvedById    String?
  approvalStatus  ApprovalStatus      @default(PENDING)
  paymentModeId   String?
  fundAccountType FundAccountType?
  fundAccountId   String?
  isSettled       Boolean             @default(false)
  organizationId  String?
  isActive        Boolean             @default(true)
  deletedAt       DateTime?
  createdById     String?
  updatedById     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  employee    Employee     @relation(fields: [employeeId], references: [id])
  paymentMode PaymentMode? @relation(fields: [paymentModeId], references: [id])

  @@index([employeeId])
  @@map("employee_advances")
}

// Money the company lends OUT to its own staff (an asset) — same
// classification note as DriverLoan above.
// EmployeeLoan / EmployeeLoanInstallment removed — merged into
// PartyLoan / PartyLoanInstallment above (borrowerType=EMPLOYEE).

// ===========================================================
// PHASE 12 — FIXED ASSET REGISTER, FASTTAG & EXPENSE MANAGEMENT
// ===========================================================
// docs/phase6-vehicle-assets-loans-expenses.md. Vehicle (Phase 4 — Fleet
// Management) is a pure operational record with zero financial fields;
// VehicleExpense/FuelEntry/MaintenanceRecord all pre-date this block.
// VehicleExpense is extended additively (not forked, unlike TripExpense)
// since nothing in the report layer depends on its current shape.
//
// Scope note: this block once also carried vehicle loans, depreciation
// runs, asset transfers, asset disposals, vehicle compliance records,
// tyre and battery tracking. All of them were removed — the asset side
// is now just a register (entry / edit / delete), its categories, and a
// read-only dashboard over them.

enum AssetType {
  VEHICLE
  LAND
  BUILDING
  FURNITURE
  COMPUTER
  MACHINERY
  OFFICE_EQUIPMENT
  WAREHOUSE_EQUIPMENT
  OTHER
}

enum DepreciationMethod {
  STRAIGHT_LINE
  WRITTEN_DOWN_VALUE
  CUSTOM
}

enum FixedAssetStatus {
  ACTIVE
  WRITTEN_OFF
}

// Depreciation policy (method / useful life / residual %) grouped per
// category. The fields below are the asset's book-value CONFIGURATION
// only — there is no depreciation run, schedule or posting anywhere in
// this system; they exist so an asset carries the terms it was bought
// under.
model AssetCategory {
  id                      String             @id @default(uuid())
  code                    String             @unique
  name                    String
  assetType               AssetType
  usefulLifeMonths        Int
  depreciationMethod      DepreciationMethod @default(STRAIGHT_LINE)
  depreciationRatePercent Decimal?           @db.Decimal(5, 2)
  residualValuePercent    Decimal            @default(5) @db.Decimal(5, 2)
  isSystemCategory        Boolean            @default(false)
  isActive                Boolean            @default(true)
  deletedAt               DateTime?
  createdById             String?
  updatedById             String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  assets FixedAsset[]

  @@map("asset_categories")
}

// The Fixed Asset Register. vehicleId links a vehicle-type asset back to
// the existing Vehicle master; null for non-vehicle assets (Land,
// Building, Furniture, Computer, ...). currentValue is entered/edited by
// hand — nothing derives it, since this system runs no depreciation.
model FixedAsset {
  id                  String                 @id @default(uuid())
  assetCode           String                 @unique
  assetName           String
  categoryId          String
  vehicleId           String?                @unique
  supplierId          String?
  purchaseDate        DateTime
  capitalizationDate  DateTime
  purchaseValue       Decimal                @db.Decimal(14, 2)
  residualValue       Decimal                @db.Decimal(14, 2)
  usefulLifeMonths    Int
  depreciationMethod  DepreciationMethod
  currentValue        Decimal                @db.Decimal(14, 2)
  departmentId        String?
  locationText        String?
  responsiblePersonId String?
  status              FixedAssetStatus       @default(ACTIVE)
  // Migration (Phase 18): an OPENING asset came across from the old Tally
  // books - purchaseValue is its ORIGINAL cost and currentValue its book
  // value on openingDate, so accumulated depreciation is exactly
  // purchaseValue - currentValue and is never stored separately. It is
  // registered already-approved because how it was originally paid for is
  // unknown and must not be guessed: no funding line, no money moved.
  assetOrigin         AssetOrigin            @default(NEW_PURCHASE)
  openingDate         DateTime?
  migrationSource     String?
  migrationStatus     MigrationRecordStatus?
  approvalStatus      ApprovalStatus         @default(PENDING)
  approvedById        String?
  organizationId      String?
  isActive            Boolean                @default(true)
  deletedAt           DateTime?
  createdById         String?
  updatedById         String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  category   AssetCategory @relation(fields: [categoryId], references: [id])
  vehicle    Vehicle?      @relation(fields: [vehicleId], references: [id])
  supplier   Supplier?     @relation(fields: [supplierId], references: [id])
  department Department?   @relation(fields: [departmentId], references: [id])

  loans Loan[]

  @@index([categoryId])
  @@map("fixed_assets")
}

// ===========================================================
// PHASE 17 — LOANS & EMI
// ===========================================================
// One generic Loan covers all five business cases (Vehicle / Bank /
// Business / Owner / Other) rather than a table per type — they differ
// only in which master they point at, never in their EMI mechanics.
// Supersedes the vehicle-only VehicleLoan model removed earlier.
//
// No balance is stored: outstanding principal is always
// principalAmount − SUM(paid installments' principalComponent), computed
// live, exactly like every other "balance" in this app. Taking out a loan
// does NOT credit a bank account here — for a vehicle loan the lender
// pays the dealer directly, so only EMI payments move real money.

enum LoanType {
  VEHICLE_LOAN
  BANK_LOAN
  BUSINESS_LOAN
  OWNER_LOAN
  OTHER_LOAN
}

enum LoanStatus {
  ACTIVE
  CLOSED
  FORECLOSED
}

enum LoanInstallmentStatus {
  PENDING
  PAID
  OVERDUE
  WAIVED
}

model Loan {
  id                  String                 @id @default(uuid())
  loanNumber          String                 @unique
  loanName            String
  lenderName          String
  loanType            LoanType
  // VEHICLE_LOAN must set vehicleId; OWNER_LOAN must set capitalPartnerId.
  // Both are enforced in loan.validator.ts, not by the DB, since one
  // nullable column cannot express "required for exactly one enum value".
  vehicleId           String?
  fixedAssetId        String?
  capitalPartnerId    String?
  loanStartDate       DateTime
  principalAmount     Decimal                @db.Decimal(14, 2)
  interestRatePercent Decimal                @default(0) @db.Decimal(5, 2)
  tenureMonths        Int
  emiAmount           Decimal                @db.Decimal(14, 2)
  firstEmiDate        DateTime
  // The account EMIs are paid FROM by default; each payment may override it.
  fundAccountType     FundAccountType
  fundAccountId       String
  loanAccountRef      String?
  // Migration (Phase 18): for an OPENING loan carried over from Tally,
  // principalAmount holds the amount STILL OWED on openingAsOfDate (so the
  // live outstanding maths needs no special case) and originalPrincipal
  // remembers what the lender originally sanctioned. EMIs paid before the
  // migration are never recreated.
  origin              LoanOrigin             @default(NEW)
  originalPrincipal   Decimal?               @db.Decimal(14, 2)
  openingAsOfDate     DateTime?
  migrationSource     String?
  migrationStatus     MigrationRecordStatus?
  status              LoanStatus             @default(ACTIVE)
  remarks             String?
  organizationId      String?
  isActive            Boolean                @default(true)
  deletedAt           DateTime?
  createdById         String?
  updatedById         String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  vehicle        Vehicle?        @relation(fields: [vehicleId], references: [id])
  fixedAsset     FixedAsset?     @relation(fields: [fixedAssetId], references: [id])
  capitalPartner CapitalPartner? @relation(fields: [capitalPartnerId], references: [id])

  installments LoanInstallment[]

  @@index([loanType])
  @@index([vehicleId])
  @@index([status])
  @@map("loans")
}

// Generated up-front from the reducing-balance schedule when the loan is
// created (loanSchedule.util.ts). Paying one is the ONLY thing that moves
// money: it debits the fund account, and writes a FinancialEntry so the
// payment shows up in Financial Entries without the user entering it twice.
model LoanInstallment {
  id                 String                @id @default(uuid())
  loanId             String
  installmentNo      Int
  dueDate            DateTime
  emiAmount          Decimal               @db.Decimal(14, 2)
  principalComponent Decimal               @db.Decimal(14, 2)
  interestComponent  Decimal               @db.Decimal(14, 2)
  status             LoanInstallmentStatus @default(PENDING)
  paidDate           DateTime?
  paidAmount         Decimal?              @db.Decimal(14, 2)
  fundAccountType    FundAccountType?
  fundAccountId      String?
  paymentModeId      String?
  referenceNumber    String?
  remarks            String?
  financialEntryId   String?
  createdById        String?
  updatedById        String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  loan        Loan         @relation(fields: [loanId], references: [id], onDelete: Cascade)
  paymentMode PaymentMode? @relation(fields: [paymentModeId], references: [id])

  @@unique([loanId, installmentNo])
  @@index([loanId])
  @@index([dueDate])
  @@index([status])
  @@map("loan_installments")
}

enum FastTagTransactionType {
  RECHARGE
  USAGE
  REFUND
  ADJUSTMENT
}

// Lifecycle of a single FastTag transaction row, independent of its
// RECHARGE/USAGE/REFUND/ADJUSTMENT type. IMPORTED is the landing state for
// rows created by the provider-statement import/reconciliation flow before
// a human confirms them; manually entered rows go straight to VERIFIED.
enum FastTagTransactionStatus {
  IMPORTED
  PENDING
  VERIFIED
  ALLOCATED
  RECONCILED
  CANCELLED
  ADJUSTED
}

enum FastTagPaymentSource {
  FASTAG_WALLET
  BANK
  OTHER
}

// A single shared prepaid wallet for the whole fleet (BlackBuck-style —
// one recharge tops up one balance; every vehicle's FASTag card draws
// down from that same balance rather than each vehicle having its own).
// The app enforces there is only ever one non-deleted row via
// fastTagRepository.getOrCreateWallet() — there is no per-vehicle account
// anymore. currentBalance is a cache (design doc §22 risk: treat as an
// estimate for dashboard purposes only until a real NHAI-statement
// reconciliation step exists — never authoritative for financial
// statements).
model FastTagAccount {
  id             String    @id @default(uuid())
  fastagNumber   String?
  currentBalance Decimal   @default(0) @db.Decimal(12, 2)
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdById    String?
  updatedById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  transactions FastTagTransaction[]

  @@map("fasttag_accounts")
}

// vehicleId identifies which truck a USAGE/REFUND transaction belongs to
// (required for USAGE, since every toll swipe is on a specific vehicle's
// tag; optional for RECHARGE/ADJUSTMENT, which are wallet-level events not
// tied to any one vehicle). fundAccountType/fundAccountId record which
// Bank/Cash account a RECHARGE actually debited — needed so edit/delete
// can reverse that debit correctly instead of only touching the wallet's
// own currentBalance cache.
model FastTagTransaction {
  id                   String                   @id @default(uuid())
  accountId            String
  vehicleId            String?
  type                 FastTagTransactionType
  amount               Decimal                  @db.Decimal(12, 2)
  tripId               String?
  transactionDate      DateTime                 @default(now())
  tollPlaza            String?
  location             String?
  transactionReference String?
  paymentSource        FastTagPaymentSource     @default(FASTAG_WALLET)
  status               FastTagTransactionStatus @default(VERIFIED)
  remarks              String?
  attachment           String?
  fundAccountType      String?
  fundAccountId        String?
  createdById          String?
  updatedById          String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  account FastTagAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  vehicle Vehicle?       @relation(fields: [vehicleId], references: [id])
  trip    Trip?          @relation(fields: [tripId], references: [id])

  financialEntries FinancialEntry[]

  @@index([accountId])
  @@index([vehicleId])
  @@index([status])
  @@index([transactionReference])
  @@map("fasttag_transactions")
}

// ===========================================================
// PHASE 13 — GST, TAXATION, FINANCIAL REPORTING & FINANCIAL CLOSING
// ===========================================================
// docs Phase 7. No new "balance" table anywhere in this block — Trial
// Balance, General Ledger, Day Book, Cash Book, Bank Book, P&L, Balance
// Sheet, Cash Flow, Fund Flow, every profitability/outstanding/expense
// report and the MIS Dashboard are pure read-side services computed live
// from Ledger/Voucher/VoucherLine (Phase 7/8's own GL), exactly like every
// Phase 6 "currentValue" cache — never a second source of truth. The
// models below exist only where the GL genuinely lacks a home for
// structured metadata a statutory return or a budget needs (HSN code,
// place-of-supply classification, TDS section, a forward-looking budgeted
// figure) — every one of them still posts its real money movement through
// the unchanged Voucher Engine; none of them stores a balance of its own.
// CashFlowCategoryMapping (Phase 9) was seeded as "foundation only, no
// report reads this table yet" — the Cash Flow Statement this phase adds
// is the first consumer.

// GST home state/registration — first 2 digits of a GSTIN already encode
// the state code, so a party's state (Customer/Supplier/Ledger.gstNumber)
// is derived at report time, never duplicated onto another table.
enum ReportFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
}

enum ReportFormat {
  PDF
  EXCEL
  CSV
}

// Foundation only (design brief: "Email Reports (Future)") — CRUD for the
// schedule definition itself; no cron/executor/email-sender exists yet,
// that belongs to Phase 8's automation/notification module.
model ReportScheduleDefinition {
  id              String          @id @default(uuid())
  name            String
  reportKey       String
  category        String
  frequency       ReportFrequency
  format          ReportFormat    @default(PDF)
  recipientEmails String?
  isActive        Boolean         @default(true)
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  createdById     String?
  updatedById     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  @@map("report_schedule_definitions")
}

// ===========================================================
// PHASE 14 — ENTERPRISE INTEGRATION, AUTOMATION, AUDIT, SECURITY
// & FINAL OPTIMIZATION (docs Phase 8 — the final phase)
// ===========================================================
// This phase does not redesign any prior module — it connects,
// automates, secures, monitors and finalizes them, exactly the way
// Phase 13 (docs Phase 7) is the first real consumer of Phase 9's
// CashFlowCategoryMapping foundation. organizationId below is a plain
// indexed scoping column (no FK) — the Phase 13 convention, since
// Organization's own relation list was never extended for those
// models either. createdById/updatedById/triggeredById/etc. are
// likewise plain actor columns, matching every prior phase.

enum AutomationTriggerType {
  SCHEDULE
  EVENT
}

enum AutomationActionType {
  SEND_NOTIFICATION
  RUN_REPORT_SCHEDULE
  RUN_BACKUP
  ARCHIVE_LOGS
  OUTSTANDING_REMINDER
  ESCALATE_APPROVALS
  COMPUTE_KPI_SNAPSHOTS
  DUPLICATE_VOUCHER_SCAN
}

enum AutomationRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum AutomationRunTrigger {
  SCHEDULE
  MANUAL
  EVENT
}

// The Automation Rule Engine + Scheduler combined into one coherent,
// testable system (design brief lists them as two modules; a
// schedule-triggered rule IS a scheduled job, so one engine drives
// both rather than duplicating a cron table and a rule table).
model AutomationRule {
  id             String                @id @default(uuid())
  organizationId String
  name           String
  description    String?
  triggerType    AutomationTriggerType
  cronExpression String?
  eventCode      String?
  actionType     AutomationActionType
  actionConfig   String? // JSON-encoded, action-specific (e.g. { "olderThanDays": 90 })
  isActive       Boolean               @default(true)
  lastRunAt      DateTime?
  lastRunStatus  AutomationRunStatus?
  nextRunAt      DateTime?
  createdById    String?
  updatedById    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?

  runLogs AutomationRunLog[]

  @@index([organizationId, isActive])
  @@map("automation_rules")
}

model AutomationRunLog {
  id               String               @id @default(uuid())
  automationRuleId String
  triggeredBy      AutomationRunTrigger
  status           AutomationRunStatus  @default(RUNNING)
  startedAt        DateTime             @default(now())
  completedAt      DateTime?
  resultSummary    String?
  errorMessage     String?

  automationRule AutomationRule @relation(fields: [automationRuleId], references: [id], onDelete: Cascade)

  @@index([automationRuleId, startedAt])
  @@map("automation_run_logs")
}

// -----------------------------------------------------------
// Notification Center
// -----------------------------------------------------------
enum NotificationCategory {
  APPROVAL
  REMINDER
  SYSTEM
  REPORT
  SECURITY
  WORKFLOW
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

model Notification {
  id                String               @id @default(uuid())
  organizationId    String
  userId            String?
  roleId            String? // broadcast to every user holding this Role, when userId is null
  category          NotificationCategory
  priority          NotificationPriority @default(NORMAL)
  channel           NotificationChannel  @default(IN_APP)
  title             String
  message           String
  relatedEntityType String?
  relatedEntityId   String?
  isRead            Boolean              @default(false)
  readAt            DateTime?
  deliveryStatus    String? // SENT / FAILED / QUEUED — only meaningful for channel EMAIL
